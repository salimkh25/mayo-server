# ============================================================================
#  NAYO server environment. Copy to ".env" and fill in. NEVER commit the real .env.
#  On a host (Hostinger/Render/Railway) set these in the dashboard instead of a file.
# ============================================================================

# ---- Core ------------------------------------------------------------------
PORT=4141
# Public URL of the live site. Used to build OAuth + Stripe redirect URLs.
PUBLIC_URL=https://nayo.co.il
# Long random string — signs login sessions. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Gate for the admin panel + admin API. Make it strong. (Also see the admin security
# note in GO-LIVE.md — this alone is not a full admin login.)
ADMIN_KEY=change-me-strong-admin-key
# Store currency (ILS = Israeli shekel).
CURRENCY=ils
# Load the sample catalog. Keep false in production so the store launches empty.
SEED_DEMO=false

# ---- Stripe (payments) -----------------------------------------------------
# From https://dashboard.stripe.com/apikeys (use test keys until you go live).
STRIPE_SECRET_KEY=
# From the webhook you create for checkout.session.completed (starts with whsec_).
STRIPE_WEBHOOK_SECRET=

# ---- Pushover (iPhone notifications) --------------------------------------
# From https://pushover.net : your user key + an application API token.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ---- Google sign-in --------------------------------------------------------
# Google Cloud Console → Credentials → OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Facebook sign-in ------------------------------------------------------
# Meta for Developers → your app → Facebook Login.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Apple sign-in ---------------------------------------------------------
# Apple Developer → Certificates, Identifiers & Profiles.
APPLE_CLIENT_ID=          # the Services ID, e.g. il.co.nayo.web
APPLE_TEAM_ID=            # 10-char Team ID
APPLE_KEY_ID=            # the Sign in with Apple key's Key ID
# Contents of the downloaded .p8 private key, with real newlines replaced by \n :
APPLE_PRIVATE_KEY=
